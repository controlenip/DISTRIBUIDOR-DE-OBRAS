[app]
timezone = "America/Fortaleza"
min_posts = 25
target_posts = 30
min_projects = 4
target_projects = 5
max_portfolio_posts = 36
max_portfolio_projects = 6
priority_enabled = true
experience_enabled = false
experience_mode = "Preferencial"
oversize_lock_enabled = true
write_enabled = false

[access]
# Se vazio, o perfil Administrador fica disponível sem PIN.
# Em produção compartilhada, defina um PIN aqui.
admin_pin = ""
default_role = "Administrador"

[notifications]
# URL de um fluxo do Power Automate/webhook que aceite JSON com title/message.
webhook_url = ""

[graph]
tenant_id = ""
client_id = ""
client_secret = ""
site_id = ""
list_id = ""

[lists.fields]
note = "N° da nota"
sgo = "Nota SGO"
status = "Status do projeto"
project_type = "PI (Tipo Projeto)"
regional = "Regional"
municipality = "Município"
deadline = "Prazo"
posts = "P L N"
assignee = "Projetistas"
completed_at = "Data de entrega do projeto"
actual_posts = "Qtd. de poste"
priority = "Prioridade"

[lists.status]
project_pool = ["Em projeto"]
completed = ["Concluído", "Concluido"]
